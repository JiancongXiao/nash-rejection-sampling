# Copy this file to cluster/b200/config.env and edit only the site paths and
# scheduler arguments.  All algorithmic settings below are part of the paper
# experiment contract and are recorded in every run manifest.

export NASHRS_REPO_ROOT="${NASHRS_REPO_ROOT:-$PWD}"
export NASHRS_EXPERIMENT_ROOT="${NASHRS_EXPERIMENT_ROOT:-$PWD/.b200-pku-tulu}"
export NASHRS_CACHE_ROOT="${NASHRS_CACHE_ROOT:-$NASHRS_EXPERIMENT_ROOT/cache}"
export NASHRS_DATA_ROOT="${NASHRS_DATA_ROOT:-$NASHRS_EXPERIMENT_ROOT/data}"
export NASHRS_RESULT_ROOT="${NASHRS_RESULT_ROOT:-$NASHRS_EXPERIMENT_ROOT/results}"
export NASHRS_VENV_ROOT="${NASHRS_VENV_ROOT:-$NASHRS_EXPERIMENT_ROOT/venvs}"
export NASHRS_SOURCE_ROOT="${NASHRS_SOURCE_ROOT:-$NASHRS_EXPERIMENT_ROOT/external}"

export NASHRS_POLICY_MODEL_ID="allenai/Llama-3.1-Tulu-3-8B-SFT"
export NASHRS_POLICY_REVISION="f2a0b46b0cfda21003c6141b1ff837b7e165524d"
export NASHRS_PREFERENCE_MODEL_ID="vectorzhou/gemma-2-2b-it-preference_dataset_mixture2_and_safe_pku-Preference"
export NASHRS_PREFERENCE_REVISION="f57f706833b6f6d758afdef3da83613e1f2a042a"
export NASHRS_PKU_REVISION="9421ffafec3fa40a1f1a7d567b4d525079477ecb"

export NASHRS_SEED=47
export NASHRS_PROMPT_MAX_LEN=128
export NASHRS_GENERATE_MAX_LEN=512
export NASHRS_GLOBAL_BATCH=64
export NASHRS_NATIVE_MICRO_BATCH=1
export NASHRS_NATIVE_GENERATE_BATCH=2
export NASHRS_LORA_RANK=16
export NASHRS_LORA_ALPHA=32
export NASHRS_LORA_DROPOUT=0.05
export NASHRS_ACTOR_LR=1e-6
export NASHRS_TAU=0.5
export NASHRS_B1=2
export NASHRS_B2=2
export NASHRS_PROPOSAL_BATCH_SIZE=8
export NASHRS_PM_BATCH_SIZE=8
export NASHRS_MAX_PROPOSALS=4096
export NASHRS_CHECKPOINT_STEPS=64
export NASHRS_EVAL_PROMPTS=256
export NASHRS_BOOTSTRAP_SAMPLES=10000

# Scheduler examples (leave blank if the scheduler has suitable defaults):
# export NASHRS_SLURM_TRAIN_ARGS="--account=my_account --partition=b200"
# export NASHRS_SLURM_EVAL_ARGS="--account=my_account --partition=b200"
# export NASHRS_PBS_TRAIN_ARGS="-P my_project -q b200"
# export NASHRS_PBS_EVAL_ARGS="-P my_project -q b200"

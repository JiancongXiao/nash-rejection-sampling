#!/bin/bash
#PBS -P CFP05-CF-001
#PBS -N nashrs_s24
#PBS -j oe
#PBS -k oed
#PBS -l walltime=02:00:00
#PBS -l select=1:ngpus=1

set -euo pipefail

cd "$PBS_O_WORKDIR"

if [[ -z "${NASHRS_EXPERIMENT_SEED:-}" ]]; then
  echo "Submit with -v NASHRS_EXPERIMENT_SEED=SEED" >&2
  exit 2
fi

export NASHRS_RUN_LABEL="24-step seed ${NASHRS_EXPERIMENT_SEED}"
export NASHRS_RESULTS_NAMESPACE="openrlhf-nashrs-3seed-24step"
export NASHRS_PROMPT_DATA="$PBS_O_WORKDIR/examples/data/ppo_pilot_prompts_128.jsonl"
export NASHRS_TEST_PROMPT_DATA="$PBS_O_WORKDIR/examples/data/ppo_test_prompts_128.jsonl"

# The first 120 unique training prompts / batch 5 = exactly 24 steps.
export NASHRS_MAX_SAMPLES=120
export NASHRS_NUM_EPISODES=1
export NASHRS_ROLLOUT_BATCH_SIZE=5
export NASHRS_MICRO_ROLLOUT_BATCH_SIZE=1
export NASHRS_VLLM_GENERATE_BATCH_SIZE=5
export NASHRS_TRAIN_BATCH_SIZE=5
export NASHRS_MICRO_TRAIN_BATCH_SIZE=1

export NASHRS_PROMPT_MAX_LEN=128
export NASHRS_GENERATE_MAX_LEN=512
export NASHRS_ACTOR_LR=1e-6
export NASHRS_CRITIC_LR=1e-5
export NASHRS_LR_WARMUP_RATIO=0.0
export NASHRS_LR_SCHEDULER=constant
export NASHRS_VERIFY_PARAMETER_UPDATE=0

export NASHRS_SAVE_STEPS=24
export NASHRS_MAX_CKPT_NUM=1
export NASHRS_RUN_FIXED_EVAL=0
export NASHRS_RUN_INDEPENDENT_EVAL=1

export NASHRS_B1=2
export NASHRS_B2=2
export NASHRS_PROPOSAL_BATCH_SIZE=4
export NASHRS_MAX_PROPOSALS=64
export NASHRS_SEED="$NASHRS_EXPERIMENT_SEED"
export NASHRS_TRAIN_SEED="$NASHRS_EXPERIMENT_SEED"

exec bash cluster/hopper/openrlhf_nash_rs_ppo_smoke.pbs

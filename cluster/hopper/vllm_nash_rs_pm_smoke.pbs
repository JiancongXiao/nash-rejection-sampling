#!/bin/bash
#PBS -P CFP05-CF-001
#PBS -N nashrs_pm
#PBS -j oe
#PBS -k oed
#PBS -l walltime=01:00:00
#PBS -l select=1:ngpus=1

set -euo pipefail

cd "$PBS_O_WORKDIR"
exec > "stdout.${PBS_JOBID}" 2> "stderr.${PBS_JOBID}"

module load singularity

IMAGE="/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif"
SCRATCH_ROOT="/scratch/jiancongxiao"
VENV="$SCRATCH_ROOT/venvs/nashrs-openrlhf-0.9.3-vllm-0.15.0"
OUTPUT="$SCRATCH_ROOT/results/nashrs-pm-smoke/${PBS_JOBID}.json"
PREFERENCE_MODEL="OpenAssistant/reward-model-deberta-v3-large-v2"
PREFERENCE_REVISION="c355404efa9ad2ad069f3a197cae0523c14244fc"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "OpenRLHF environment is missing: $VENV" >&2
  exit 2
fi

mkdir -p \
  "$SCRATCH_ROOT/cache/huggingface" \
  "$SCRATCH_ROOT/cache/torch" \
  "$SCRATCH_ROOT/cache/triton" \
  "$SCRATCH_ROOT/tmp" \
  "$(dirname "$OUTPUT")"

echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Output: $OUTPUT"

# Hopper's route to the Xet CAS endpoint can reset large transfers. Disable
# hf-xet and prefetch the pinned model over the regular Hub HTTP path, retrying
# before starting vLLM so a network failure does not hold initialized GPU state.
download_ok=0
for attempt in 1 2 3; do
  echo "Preference-model download attempt $attempt/3"
  if singularity exec -e "$IMAGE" env \
    HF_HOME="$SCRATCH_ROOT/cache/huggingface" \
    HUGGINGFACE_HUB_CACHE="$SCRATCH_ROOT/cache/huggingface/hub" \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_DOWNLOAD_TIMEOUT=300 \
    TMPDIR="$SCRATCH_ROOT/tmp" \
    "$VENV/bin/python" -c \
      "from huggingface_hub import snapshot_download; snapshot_download('$PREFERENCE_MODEL', revision='$PREFERENCE_REVISION', max_workers=1)"; then
    download_ok=1
    break
  fi
  sleep "$((attempt * 10))"
done
if [[ "$download_ok" -ne 1 ]]; then
  echo "Preference-model download failed after 3 attempts" >&2
  exit 3
fi

# PBS owns GPU selection. Do not set CUDA_VISIBLE_DEVICES.
singularity exec -e --nv "$IMAGE" env \
  HF_HOME="$SCRATCH_ROOT/cache/huggingface" \
  HUGGINGFACE_HUB_CACHE="$SCRATCH_ROOT/cache/huggingface/hub" \
  HF_HUB_DISABLE_XET=1 \
  HF_HUB_DOWNLOAD_TIMEOUT=300 \
  TORCH_HOME="$SCRATCH_ROOT/cache/torch" \
  TRITON_CACHE_DIR="$SCRATCH_ROOT/cache/triton" \
  TMPDIR="$SCRATCH_ROOT/tmp" \
  VLLM_WORKER_MULTIPROC_METHOD=spawn \
  "$VENV/bin/python" examples/vllm_nash_rs_pm_smoke.py \
    --model Qwen/Qwen2.5-0.5B-Instruct \
    --preference-model "$PREFERENCE_MODEL" \
    --preference-revision "$PREFERENCE_REVISION" \
    --output "$OUTPUT"

echo "Nash-RS real preference-model smoke test completed successfully."

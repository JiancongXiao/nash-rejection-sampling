#!/bin/bash
#PBS -P CFP05-CF-001
#PBS -N main_env
#PBS -j oe
#PBS -k oed
#PBS -l walltime=01:00:00
#PBS -l select=1:ngpus=1

set -euo pipefail
cd "$PBS_O_WORKDIR"
exec > "stdout.${PBS_JOBID}" 2> "stderr.${PBS_JOBID}"

module load singularity
IMAGE="/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif"
BASE="/scratch/jiancongxiao/venvs/nashrs-openrlhf-0.9.3-vllm-0.15.0"
VENV="/scratch/jiancongxiao/venvs/nashrs-main-native-0.1"
CACHE="/scratch/jiancongxiao/cache/pip"
TMP="/scratch/jiancongxiao/tmp/main-native-env"
mkdir -p "$CACHE" "$TMP"

if [[ ! -x "$VENV/bin/python" ]]; then
  cp -a "$BASE" "$VENV"
fi

singularity exec --nv "$IMAGE" env \
  PIP_CACHE_DIR="$CACHE" TMPDIR="$TMP" \
  "$VENV/bin/python" -m pip install \
    --no-deps --force-reinstall \
    'accelerate==1.2.1' \
    'datasets==3.2.0' \
    'transformers==4.48.0' \
    'trl==0.13.0' \
    'peft==0.14.0' \
    'tokenizers==0.21.0' \
    'huggingface-hub==0.27.1' \
    'safetensors==0.5.2' \
    'dill==0.3.8' \
    'fsspec==2024.2.0' \
    'multiprocess==0.70.16' \
    'pyarrow==18.1.0'

bash cluster/hopper/main/setup_sources.sh

singularity exec --nv "$IMAGE" env \
  PYTHONPATH="$PBS_O_WORKDIR/src" \
  "$VENV/bin/python" - <<'PY'
import accelerate, datasets, peft, tokenizers, torch, transformers, trl
from trl import NashMDConfig, NashMDTrainer
print("torch:", torch.__version__)
print("transformers:", transformers.__version__)
print("trl:", trl.__version__)
print("accelerate:", accelerate.__version__)
print("datasets:", datasets.__version__)
print("peft:", peft.__version__)
print("tokenizers:", tokenizers.__version__)
print("cuda:", torch.cuda.is_available())
print("gpu:", torch.cuda.get_device_name(0))
print("Nash-MD API:", NashMDConfig.__name__, NashMDTrainer.__name__)
PY

echo "Main native environment completed successfully: $VENV"

#!/bin/bash
#PBS -P CFP05-CF-001
#PBS -N eval3b
#PBS -j oe
#PBS -k oed
#PBS -l walltime=08:00:00
#PBS -l select=1:ngpus=1

set -euo pipefail
cd "$PBS_O_WORKDIR"
exec > "stdout.${PBS_JOBID}" 2> "stderr.${PBS_JOBID}"

MODELS_JSON="${NASHRS_MAIN_MODELS_JSON:?submit with NASHRS_MAIN_MODELS_JSON}"
SEED="${NASHRS_SEED:-47}"
DATA_ROOT="/scratch/jiancongxiao/datasets/ultrafeedback_nashrs_2k_v1"
PROMPTS="${NASHRS_EVAL_PROMPTS:-$DATA_ROOT/selection_256.jsonl}"
MAX_PROMPTS="${NASHRS_EVAL_MAX_PROMPTS:-256}"
MAX_NEW_TOKENS="${NASHRS_EVAL_MAX_NEW_TOKENS:-512}"
EXPECTED_MODEL_COUNT="${NASHRS_EVAL_EXPECTED_MODEL_COUNT:-6}"
OUTPUT_NAMESPACE="${NASHRS_EVAL_RESULTS_NAMESPACE:-main-native-3b-full-seed${SEED}/evaluation-six}"
OUTPUT="/scratch/jiancongxiao/results/$OUTPUT_NAMESPACE/${PBS_JOBID}"
CONFIG="$PBS_O_WORKDIR/configs/general_preference_primary.json"
REVISION="aa8e72537993ba99e69dfaafa59ed015b17504d1"
BASE_MODEL="/scratch/jiancongxiao/cache/huggingface/hub/models--Qwen--Qwen2.5-3B-Instruct/snapshots/$REVISION"
IMAGE="/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif"
VENV="/scratch/jiancongxiao/venvs/nashrs-openrlhf-0.9.3-vllm-0.15.0"
HF_CACHE="/scratch/jiancongxiao/cache/huggingface/hub"
mkdir -p "$OUTPUT"

for required in "$MODELS_JSON" "$PROMPTS" "$CONFIG" "$BASE_MODEL/config.json"; do
  if [[ ! -f "$required" ]]; then
    echo "Missing 3B Main evaluation input: $required" >&2
    exit 2
  fi
done

MODEL_COUNT="$(jq 'length' "$MODELS_JSON")"
if [[ "$MODEL_COUNT" != "$EXPECTED_MODEL_COUNT" ]]; then
  echo "Expected $EXPECTED_MODEL_COUNT trained models, found $MODEL_COUNT" >&2
  exit 3
fi
while IFS= read -r actor; do
  if [[ ! -f "$actor/config.json" ]]; then
    echo "Missing trained actor: $actor" >&2
    exit 4
  fi
done < <(jq -r '.[]' "$MODELS_JSON")

module load singularity
PBS_GPU="${CUDA_VISIBLE_DEVICES:-}"
if [[ "$PBS_GPU" == GPU-* ]]; then
  GPU_INDEX="$(nvidia-smi --id="$PBS_GPU" --query-gpu=index --format=csv,noheader,nounits | head -1 | tr -d '[:space:]')"
else
  GPU_INDEX="$PBS_GPU"
fi
if [[ ! "$GPU_INDEX" =~ ^[0-9]+$ ]]; then
  echo "Could not map PBS GPU: $PBS_GPU" >&2
  exit 5
fi

echo "Suite: Main"
echo "Run kind: full_3b_six_method_evaluation"
echo "Seed: $SEED"
echo "Models: $MODELS_JSON"
echo "Prompts: $PROMPTS (first $MAX_PROMPTS)"
echo "Maximum new tokens: $MAX_NEW_TOKENS"
echo "Output: $OUTPUT"

cp "$MODELS_JSON" "$OUTPUT/models.json"
python3 - "$OUTPUT/eval_config.json" <<PY
import json
import pathlib
import sys

pathlib.Path(sys.argv[1]).write_text(json.dumps({
    "suite": "main",
    "run_kind": "full_3b_six_method_evaluation",
    "seed": int("$SEED"),
    "prompts": "$PROMPTS",
    "max_prompts": int("$MAX_PROMPTS"),
    "max_new_tokens": int("$MAX_NEW_TOKENS"),
    "preference_config": "$CONFIG",
    "generation": "greedy",
    "bootstrap_samples": 10000,
    "bootstrap_seed": 20260901,
}, indent=2, sort_keys=True) + "\n")
PY

singularity exec --nv "$IMAGE" env \
  CUDA_VISIBLE_DEVICES="$GPU_INDEX" \
  HF_HOME="/scratch/jiancongxiao/cache/huggingface" \
  HUGGINGFACE_HUB_CACHE="$HF_CACHE" \
  HF_HUB_DISABLE_XET=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
  TOKENIZERS_PARALLELISM=false \
  PYTHONPATH="$PBS_O_WORKDIR/src:$PBS_O_WORKDIR" \
  "$VENV/bin/python" examples/evaluate_ppo_checkpoints.py \
    --prompts "$PROMPTS" \
    --max-prompts "$MAX_PROMPTS" \
    --base-model "$BASE_MODEL" \
    --models-json "$MODELS_JSON" \
    --preference-config "$CONFIG" \
    --max-new-tokens "$MAX_NEW_TOKENS" \
    --generation-backend vllm \
    --bootstrap-samples 10000 \
    --bootstrap-seed 20260901 \
    --run-seed "$SEED" \
    --output-dir "$OUTPUT"

test -s "$OUTPUT/summary.json"
echo "Main 3B six-method evaluation completed: $OUTPUT/summary.json"

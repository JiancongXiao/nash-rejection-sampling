#!/bin/bash
#PBS -P CFP05-CF-001
#PBS -N main512
#PBS -j oe
#PBS -k oed
#PBS -l walltime=08:00:00
#PBS -l select=1:ngpus=1

set -euo pipefail
cd "$PBS_O_WORKDIR"
exec > "stdout.${PBS_JOBID}" 2> "stderr.${PBS_JOBID}"

METHOD="${NASHRS_MAIN_METHOD:?submit with NASHRS_MAIN_METHOD}"
SEED="${NASHRS_SEED:?submit with NASHRS_SEED}"
PROMPT_BUDGET="${NASHRS_MAIN_PROMPT_BUDGET:-512}"
MAX_NEW_TOKENS="${NASHRS_MAIN_GENERATE_MAX_LEN:-512}"
TAU="${NASHRS_TAU:-1.0}"
MAX_PROPOSALS="${NASHRS_MAX_PROPOSALS:-64}"
RUN_KIND="${NASHRS_MAIN_RUN_KIND:-scaling_gate}"
MODEL_ID="${NASHRS_POLICY_MODEL_ID:-Qwen/Qwen2.5-0.5B-Instruct}"
case "$METHOD" in
  reward_ppo|self_play|nash_md|nash_rs|mpo|egpo|comal) ;;
  *) echo "Unknown Main method: $METHOD" >&2; exit 2 ;;
esac
case "$RUN_KIND" in
  scaling_gate|full) ;;
  *) echo "Unsupported Main run kind: $RUN_KIND" >&2; exit 2 ;;
esac
if [[ "$METHOD" == "comal" && "$RUN_KIND" == "full" ]]; then
  echo "Full COMAL must use main_3b_comal_full.pbs, not the inner-update runner" >&2
  exit 2
fi
if (( PROMPT_BUDGET <= 0 )); then
  echo "Prompt budget must be positive: $PROMPT_BUDGET" >&2
  exit 3
fi
if (( MAX_PROPOSALS <= 0 )); then
  echo "NASHRS_MAX_PROPOSALS must be positive: $MAX_PROPOSALS" >&2
  exit 3
fi
python3 - "$TAU" <<'PY'
import math
import sys

tau = float(sys.argv[1])
if not math.isfinite(tau) or tau <= 0:
    raise SystemExit(f"NASHRS_TAU must be positive and finite, got {tau!r}")
PY

# One OpenRLHF global step consumes a rollout batch of two prompts.  The TRL,
# EGPO, and COMAL native entries consume one prompt per optimizer step.  MPO
# performs two inner optimizer steps per outer prompt.  We fix the prompt/data
# budget and preserve these method-native update schedules.
case "$METHOD" in
  reward_ppo|nash_rs) EXPECTED_STEPS="$(((PROMPT_BUDGET + 1) / 2))" ;;
  mpo) EXPECTED_STEPS="$((PROMPT_BUDGET * 2))" ;;
  self_play|nash_md|egpo|comal) EXPECTED_STEPS="$PROMPT_BUDGET" ;;
esac

CONFIG="$PBS_O_WORKDIR/configs/general_preference_primary.json"
DATA_ROOT="/scratch/jiancongxiao/datasets/ultrafeedback_nashrs_2k_v1"
PROMPTS="${NASHRS_MAIN_PROMPTS:-$DATA_ROOT/train_2048.jsonl}"
SOURCE_ROOT="${NASHRS_MAIN_SOURCE_ROOT:-/scratch/jiancongxiao/external/nashrs-main}"
NAMESPACE="${NASHRS_RESULTS_NAMESPACE_OVERRIDE:-main-native-0p5b-512-seed${SEED}/$METHOD}"
RESULT_ROOT="/scratch/jiancongxiao/results/$NAMESPACE/${PBS_JOBID}"
MODEL_CACHE="${NASHRS_POLICY_MODEL_CACHE:-/scratch/jiancongxiao/cache/huggingface/hub/models--Qwen--Qwen2.5-0.5B-Instruct}"
IMAGE="/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif"
VENV="/scratch/jiancongxiao/venvs/nashrs-main-native-0.1"
HF_CACHE="/scratch/jiancongxiao/cache/huggingface/hub"
mkdir -p "$RESULT_ROOT"

for required in "$CONFIG" "$PROMPTS" "$VENV/bin/python"; do
  if [[ ! -e "$required" ]]; then
    echo "Missing Main scaling-gate input: $required" >&2
    exit 4
  fi
done
MODEL=""
for candidate in "$MODEL_CACHE"/snapshots/*; do
  if [[ -f "$candidate/config.json" ]]; then MODEL="$candidate"; break; fi
done
if [[ -z "$MODEL" ]]; then
  echo "No cached policy snapshot for $MODEL_ID under $MODEL_CACHE" >&2
  exit 5
fi

module load singularity
PBS_GPU="${CUDA_VISIBLE_DEVICES:-}"
if [[ "$PBS_GPU" == GPU-* ]]; then
  GPU_INDEX="$(nvidia-smi --id="$PBS_GPU" --query-gpu=index --format=csv,noheader,nounits | head -1 | tr -d '[:space:]')"
else
  GPU_INDEX="$PBS_GPU"
fi
if [[ ! "$GPU_INDEX" =~ ^[0-9]+$ ]]; then
  echo "Could not map PBS GPU: $PBS_GPU" >&2
  exit 6
fi

echo "Suite: Main"
echo "Run kind: $RUN_KIND"
echo "Model ID: $MODEL_ID"
echo "Method: $METHOD"
echo "Seed: $SEED"
echo "Prompt budget: $PROMPT_BUDGET"
echo "Expected optimizer steps: $EXPECTED_STEPS"
echo "Maximum new tokens: $MAX_NEW_TOKENS"
echo "Nash-RS tau: $TAU"
echo "Nash-RS maximum proposals per accepted batch: $MAX_PROPOSALS"
echo "Prompts: $PROMPTS"
echo "Model: $MODEL"
echo "Result root: $RESULT_ROOT"

python3 - "$RESULT_ROOT/run_config.json" <<PY
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
path.write_text(json.dumps({
    "suite": "main",
    "run_kind": "$RUN_KIND",
    "model": "$MODEL_ID",
    "method": "$METHOD",
    "seed": int("$SEED"),
    "prompt_budget": int("$PROMPT_BUDGET"),
    "expected_optimizer_steps": int("$EXPECTED_STEPS"),
    "prompt_max_length": 128,
    "generation_max_length": int("$MAX_NEW_TOKENS"),
    "prompts": "$PROMPTS",
    "preference_config": "$CONFIG",
    "nash_rs_b1": 2,
    "nash_rs_b2": 2,
    "nash_rs_tau": float("$TAU"),
    "nash_rs_max_proposals": int("$MAX_PROPOSALS"),
}, indent=2, sort_keys=True) + "\n")
PY

if [[ "$METHOD" == "reward_ppo" || "$METHOD" == "nash_rs" ]]; then
  export NASHRS_RUN_LABEL="Main native $RUN_KIND: $MODEL_ID $METHOD seed $SEED tau $TAU"
  export NASHRS_RESULTS_NAMESPACE="$NAMESPACE"
  export NASHRS_POLICY_MODEL_ID="$MODEL_ID"
  export NASHRS_POLICY_MODEL_CACHE="$MODEL_CACHE"
  export NASHRS_PROMPT_DATA="$PROMPTS"
  export NASHRS_MAX_SAMPLES="$PROMPT_BUDGET"
  export NASHRS_NUM_EPISODES=1
  export NASHRS_ROLLOUT_BATCH_SIZE=2
  export NASHRS_MICRO_ROLLOUT_BATCH_SIZE=1
  export NASHRS_VLLM_GENERATE_BATCH_SIZE=2
  export NASHRS_TRAIN_BATCH_SIZE=2
  export NASHRS_MICRO_TRAIN_BATCH_SIZE=1
  export NASHRS_PROMPT_MAX_LEN=128
  export NASHRS_GENERATE_MAX_LEN="$MAX_NEW_TOKENS"
  export NASHRS_ACTOR_LR=1e-6
  export NASHRS_CRITIC_LR=1e-5
  export NASHRS_LR_WARMUP_RATIO=0.0
  export NASHRS_LR_SCHEDULER=constant
  export NASHRS_SAVE_STEPS=-1
  export NASHRS_MAX_CKPT_NUM=1
  export NASHRS_VERIFY_PARAMETER_UPDATE=1
  export NASHRS_RUN_FIXED_EVAL=0
  export NASHRS_RUN_INDEPENDENT_EVAL=0
  export NASHRS_VLLM_GPU_MEMORY_UTILIZATION="${NASHRS_VLLM_GPU_MEMORY_UTILIZATION:-0.20}"
  export NASHRS_VLLM_ENABLE_SLEEP="${NASHRS_VLLM_ENABLE_SLEEP:-0}"
  export NASHRS_DEEPSPEED_ENABLE_SLEEP="${NASHRS_DEEPSPEED_ENABLE_SLEEP:-0}"
  export NASHRS_ADAM_OFFLOAD="${NASHRS_ADAM_OFFLOAD:-0}"
  export NASHRS_GRADIENT_CHECKPOINTING="${NASHRS_GRADIENT_CHECKPOINTING:-0}"
  export NASHRS_SEED="$SEED"
  export NASHRS_TRAIN_SEED="$SEED"
  export NASHRS_METHOD="$METHOD"
  export NASHRS_TAU="$TAU"
  export NASHRS_B1=2 NASHRS_B2=2
  export NASHRS_PROPOSAL_BATCH_SIZE="${NASHRS_PROPOSAL_BATCH_SIZE:-4}"
  export NASHRS_MAX_PROPOSALS="$MAX_PROPOSALS"
  if [[ "$METHOD" == "nash_rs" ]]; then
    export NASHRS_AGENT_FUNC_PATH="$PBS_O_WORKDIR/examples/openrlhf/nash_rs_agent.py"
  else
    export NASHRS_AGENT_FUNC_PATH="$PBS_O_WORKDIR/examples/openrlhf/preference_ppo_agent.py"
  fi
  export NASHRS_PREFERENCE_COMPONENTS_JSON="$(python3 - "$CONFIG" <<'PY'
import json, sys
print(json.dumps(json.load(open(sys.argv[1]))["components"], separators=(",", ":")))
PY
)"
  bash cluster/hopper/openrlhf_nash_rs_ppo_smoke.pbs
else
  export NASHRS_PREFERENCE_PYTHON="/scratch/jiancongxiao/venvs/nashrs-openrlhf-0.9.3-vllm-0.15.0/bin/python"
  export NASHRS_PREFERENCE_SIDECAR_LOG="$RESULT_ROOT/preference_sidecar.log"
  DRIVER=()
  case "$METHOD" in
    self_play|nash_md)
      DRIVER=( -m examples.main.trl_nash_md_smoke --method "$METHOD" ) ;;
    egpo)
      DRIVER=( -m examples.main.egpo_official_smoke --source-root "$SOURCE_ROOT" ) ;;
    comal)
      DRIVER=( -m examples.main.comal_official_smoke --source-root "$SOURCE_ROOT" ) ;;
    mpo)
      DRIVER=( -m examples.main.mpo_native_smoke ) ;;
  esac
  singularity exec --nv "$IMAGE" env \
    CUDA_VISIBLE_DEVICES="$GPU_INDEX" \
    HF_HOME="/scratch/jiancongxiao/cache/huggingface" \
    HUGGINGFACE_HUB_CACHE="$HF_CACHE" \
    HF_HUB_DISABLE_XET=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONPATH="$PBS_O_WORKDIR/src:$PBS_O_WORKDIR" \
    "$VENV/bin/python" "${DRIVER[@]}" \
      --model "$MODEL" \
      --prompts "$PROMPTS" \
      --preference-config "$CONFIG" \
      --output "$RESULT_ROOT" \
      --steps "$EXPECTED_STEPS" \
      --max-new-tokens "$MAX_NEW_TOKENS" \
      --seed "$SEED"
fi

singularity exec "$IMAGE" env PYTHONPATH="$PBS_O_WORKDIR/src:$PBS_O_WORKDIR" \
  "$VENV/bin/python" -m examples.main.finalize_run \
    --method "$METHOD" --run-kind "$RUN_KIND" --steps "$EXPECTED_STEPS" \
    --metrics "$RESULT_ROOT/step_metrics.jsonl" \
    --parameter-update "$RESULT_ROOT/parameter_update.json" \
    --output "$RESULT_ROOT/run_manifest.json"

echo "Main $METHOD seed $SEED $RUN_KIND completed successfully"

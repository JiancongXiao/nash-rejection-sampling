#!/bin/bash
#PBS -P CFP05-CF-001
#PBS -N l8b_smoke
#PBS -j oe
#PBS -k oed
#PBS -l walltime=04:00:00
#PBS -l select=1:ngpus=1

set -euo pipefail
cd "$PBS_O_WORKDIR"

METHOD="${NASHRS_MAIN_METHOD:?submit with NASHRS_MAIN_METHOD}"
SEED="${NASHRS_SEED:-47}"
case "$METHOD" in
  nash_rs)
    # OpenRLHF consumes two prompts per optimizer step.
    PROMPT_BUDGET=4
    ;;
  nash_md|egpo)
    PROMPT_BUDGET=2
    ;;
  mpo)
    # The paper-native MPO entry performs two inner steps per prompt.
    PROMPT_BUDGET=1
    ;;
  *)
    echo "Llama 8B smoke only supports nash_rs, nash_md, mpo, egpo" >&2
    exit 2
    ;;
esac

# Keep this engineering smoke isolated from both Qwen and the full Llama run.
# Every method performs exactly two real optimizer steps and must pass the
# common parameter-update and metrics-manifest checks.
export NASHRS_MAIN_RUN_KIND=scaling_gate
export NASHRS_MAIN_PROMPT_BUDGET="$PROMPT_BUDGET"
export NASHRS_MAIN_GENERATE_MAX_LEN=64
export NASHRS_MAIN_PROMPTS="$PBS_O_WORKDIR/examples/data/ppo_pilot_prompts_32.jsonl"
export NASHRS_RESULTS_NAMESPACE_OVERRIDE="main-native-llama3p1-8b-lora-smoke-seed${SEED}/${METHOD}"
export NASHRS_POLICY_MODEL_ID="meta-llama/Llama-3.1-8B-Instruct"
export NASHRS_POLICY_MODEL_CACHE="/scratch/jiancongxiao/cache/huggingface/hub/models--meta-llama--Llama-3.1-8B-Instruct"
export NASHRS_NASH_MD_MODULE="examples.main.trl_nash_md_cached"
export NASHRS_TAU="${NASHRS_TAU:-0.5}"
export NASHRS_MAX_PROPOSALS="${NASHRS_MAX_PROPOSALS:-16}"
export NASHRS_LORA_RANK=16
export NASHRS_LORA_ALPHA=32
export NASHRS_LORA_DROPOUT=0.05
export NASHRS_SAVE_STEPS=-1
export NASHRS_MAX_CKPT_NUM=1
export NASHRS_NATIVE_CHECKPOINT_STEPS=0

export NASHRS_VLLM_GPU_MEMORY_UTILIZATION=0.28
export NASHRS_VLLM_ENABLE_SLEEP=1
export NASHRS_DEEPSPEED_ENABLE_SLEEP=1
export NASHRS_ADAM_OFFLOAD=1
export NASHRS_GRADIENT_CHECKPOINTING=1

bash cluster/hopper/main/main_0p5b_512.pbs


#!/bin/bash
#PBS -P CFP05-CF-001
#PBS -N nashrs_ppo
#PBS -j oe
#PBS -k oed
#PBS -l walltime=02:00:00
#PBS -l select=1:ngpus=1

set -euo pipefail

cd "$PBS_O_WORKDIR"
exec > "stdout.${PBS_JOBID}" 2> "stderr.${PBS_JOBID}"

module load singularity

IMAGE="/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif"
SCRATCH_ROOT="/scratch/jiancongxiao"
VENV="$SCRATCH_ROOT/venvs/nashrs-openrlhf-0.9.3-vllm-0.15.0"
MODEL_ID="Qwen/Qwen2.5-0.5B-Instruct"
PM_MODEL="OpenAssistant/reward-model-deberta-v3-large-v2"
PM_REVISION="c355404efa9ad2ad069f3a197cae0523c14244fc"
HF_CACHE="$SCRATCH_ROOT/cache/huggingface/hub"
MODEL_CACHE="$HF_CACHE/models--Qwen--Qwen2.5-0.5B-Instruct"
CUDA_DRIVER_LIB="$SCRATCH_ROOT/cuda-driver-lib"
RUN_LABEL="${NASHRS_RUN_LABEL:-smoke test}"
RESULTS_NAMESPACE="${NASHRS_RESULTS_NAMESPACE:-openrlhf-nashrs-ppo}"
PROMPT_DATA="${NASHRS_PROMPT_DATA:-$PBS_O_WORKDIR/examples/data/ppo_smoke_prompts.jsonl}"
MAX_SAMPLES="${NASHRS_MAX_SAMPLES:-2}"
TRAIN_BATCH_SIZE="${NASHRS_TRAIN_BATCH_SIZE:-2}"
MICRO_TRAIN_BATCH_SIZE="${NASHRS_MICRO_TRAIN_BATCH_SIZE:-1}"
ROLLOUT_BATCH_SIZE="${NASHRS_ROLLOUT_BATCH_SIZE:-2}"
MICRO_ROLLOUT_BATCH_SIZE="${NASHRS_MICRO_ROLLOUT_BATCH_SIZE:-1}"
VLLM_GENERATE_BATCH_SIZE="${NASHRS_VLLM_GENERATE_BATCH_SIZE:-2}"
PROMPT_MAX_LEN="${NASHRS_PROMPT_MAX_LEN:-128}"
GENERATE_MAX_LEN="${NASHRS_GENERATE_MAX_LEN:-48}"
ACTOR_LR="${NASHRS_ACTOR_LR:-1e-3}"
CRITIC_LR="${NASHRS_CRITIC_LR:-1e-5}"
LR_WARMUP_RATIO="${NASHRS_LR_WARMUP_RATIO:-0.0}"
LR_SCHEDULER="${NASHRS_LR_SCHEDULER:-constant}"
VERIFY_PARAMETER_UPDATE="${NASHRS_VERIFY_PARAMETER_UPDATE:-1}"
NUM_EPISODES="${NASHRS_NUM_EPISODES:-1}"
SAVE_STEPS="${NASHRS_SAVE_STEPS:--1}"
MAX_CKPT_NUM="${NASHRS_MAX_CKPT_NUM:-4}"
RUN_FIXED_EVAL="${NASHRS_RUN_FIXED_EVAL:-0}"
EVAL_PROMPT_DATA="${NASHRS_EVAL_PROMPT_DATA:-$PBS_O_WORKDIR/examples/data/ppo_eval_prompts_16.jsonl}"
RUN_INDEPENDENT_EVAL="${NASHRS_RUN_INDEPENDENT_EVAL:-0}"
TEST_PROMPT_DATA="${NASHRS_TEST_PROMPT_DATA:-$PBS_O_WORKDIR/examples/data/ppo_test_prompts_128.jsonl}"
METHOD_SEED="${NASHRS_SEED:-29}"
TRAIN_SEED="${NASHRS_TRAIN_SEED:-$METHOD_SEED}"
RUN_ROOT="$SCRATCH_ROOT/results/$RESULTS_NAMESPACE/${PBS_JOBID}"
JOB_NUMBER="${PBS_JOBID%%.*}"
RAY_ROOT="/tmp/nashrs-ray-$JOB_NUMBER"
RAY_LOG_ARCHIVE="$RUN_ROOT/ray-logs"
SAVE_PATH="$RUN_ROOT/actor"
CKPT_PATH="$RUN_ROOT/deepspeed"
VERIFY_OUTPUT="$RUN_ROOT/parameter_update.json"
METRICS_OUTPUT="$RUN_ROOT/step_metrics.jsonl"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "OpenRLHF environment is missing: $VENV" >&2
  exit 2
fi
shopt -s nullglob
MODEL_SNAPSHOTS=("$MODEL_CACHE"/snapshots/*)
MODEL=""
for candidate in "${MODEL_SNAPSHOTS[@]}"; do
  if [[ -f "$candidate/config.json" ]]; then
    MODEL="$candidate"
    break
  fi
done
if [[ -z "$MODEL" ]]; then
  echo "No usable cached policy snapshot found under: $MODEL_CACHE/snapshots" >&2
  exit 3
fi
MODEL_REVISION="$(basename "$MODEL")"

mkdir -p \
  "$SCRATCH_ROOT/cache/huggingface" \
  "$SCRATCH_ROOT/cache/torch" \
  "$SCRATCH_ROOT/cache/triton" \
  "$CUDA_DRIVER_LIB" \
  "$SCRATCH_ROOT/tmp" \
  "$RUN_ROOT"

# Triton searches for an unversioned libcuda.so. The Hopper container exposes
# the driver as libcuda.so.1 under CUDA's compatibility directory.
ln -sfn /usr/local/cuda/compat/lib/libcuda.so.1 "$CUDA_DRIVER_LIB/libcuda.so"
ln -sfn /usr/local/cuda/compat/lib/libcuda.so.1 "$CUDA_DRIVER_LIB/libcuda.so.1"

archive_ray_logs() {
  local session
  session="$(readlink -f "$RAY_ROOT/session_latest" 2>/dev/null || true)"
  if [[ -n "$session" && -d "$session/logs" ]]; then
    mkdir -p "$RAY_LOG_ARCHIVE"
    cp -a "$session/logs/." "$RAY_LOG_ARCHIVE/" || true
  fi
}
trap archive_ray_logs EXIT

echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Run label: $RUN_LABEL"
echo "Policy model: $MODEL_ID"
echo "Policy revision: $MODEL_REVISION"
echo "Local policy snapshot: $MODEL"
echo "Run root: $RUN_ROOT"
echo "Ray root: $RAY_ROOT"
echo "Method seed: $METHOD_SEED"
echo "OpenRLHF training seed: $TRAIN_SEED"
echo "Samples / episodes / rollout batch: $MAX_SAMPLES / $NUM_EPISODES / $ROLLOUT_BATCH_SIZE"
echo "Prompt / generation length: $PROMPT_MAX_LEN / $GENERATE_MAX_LEN"
echo "PBS CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-<unset>}"

PBS_GPU_ASSIGNMENT="${CUDA_VISIBLE_DEVICES:-}"
if [[ "$PBS_GPU_ASSIGNMENT" == *,* ]]; then
  echo "This one-GPU smoke test received multiple PBS GPU identifiers: $PBS_GPU_ASSIGNMENT" >&2
  exit 4
elif [[ "$PBS_GPU_ASSIGNMENT" == GPU-* ]]; then
  VLLM_GPU_INDEX="$(
    nvidia-smi \
      --id="$PBS_GPU_ASSIGNMENT" \
      --query-gpu=index \
      --format=csv,noheader,nounits \
      | head -1 | tr -d '[:space:]'
  )"
elif [[ "$PBS_GPU_ASSIGNMENT" =~ ^[0-9]+$ ]]; then
  VLLM_GPU_INDEX="$PBS_GPU_ASSIGNMENT"
else
  echo "Unsupported or missing PBS GPU assignment: $PBS_GPU_ASSIGNMENT" >&2
  exit 5
fi
if [[ ! "$VLLM_GPU_INDEX" =~ ^[0-9]+$ ]]; then
  echo "Failed to map PBS GPU assignment to an index: $PBS_GPU_ASSIGNMENT" >&2
  exit 6
fi
echo "PBS GPU index for vLLM: $VLLM_GPU_INDEX"

# Preserve PBS's exact device choice while converting its UUID to the numeric
# form required by vLLM 0.15 inside the container.
singularity exec --nv "$IMAGE" env \
  CUDA_VISIBLE_DEVICES="$VLLM_GPU_INDEX" \
  NASHRS_PBS_GPU_ASSIGNMENT="$PBS_GPU_ASSIGNMENT" \
  TRITON_LIBCUDA_PATH="$CUDA_DRIVER_LIB" \
  HF_HOME="$SCRATCH_ROOT/cache/huggingface" \
  HUGGINGFACE_HUB_CACHE="$HF_CACHE" \
  HF_HUB_DISABLE_XET=1 \
  HF_HUB_OFFLINE=1 \
  TRANSFORMERS_OFFLINE=1 \
  TORCH_HOME="$SCRATCH_ROOT/cache/torch" \
  TRITON_CACHE_DIR="$SCRATCH_ROOT/cache/triton" \
  TMPDIR="$SCRATCH_ROOT/tmp" \
  RAY_TMPDIR="/tmp" \
  NASHRS_RAY_TMPDIR="$RAY_ROOT" \
  PYTHONPATH="$PBS_O_WORKDIR/src" \
  TOKENIZERS_PARALLELISM=true \
  OMP_NUM_THREADS=4 \
  NASHRS_TAU=1.0 \
  NASHRS_B1="${NASHRS_B1:-2}" \
  NASHRS_B2="${NASHRS_B2:-2}" \
  NASHRS_PROPOSAL_BATCH_SIZE="${NASHRS_PROPOSAL_BATCH_SIZE:-4}" \
  NASHRS_MAX_PROPOSALS="${NASHRS_MAX_PROPOSALS:-64}" \
  NASHRS_SEED="$METHOD_SEED" \
  NASHRS_REFERENCE_MODEL="$MODEL" \
  NASHRS_PREFERENCE_MODEL="$PM_MODEL" \
  NASHRS_PREFERENCE_REVISION="$PM_REVISION" \
  "$VENV/bin/python" "$PBS_O_WORKDIR/examples/openrlhf/train_ppo_ray_pbs.py" \
    --ref_num_nodes 1 \
    --ref_num_gpus_per_node 1 \
    --critic_num_nodes 1 \
    --critic_num_gpus_per_node 1 \
    --actor_num_nodes 1 \
    --actor_num_gpus_per_node 1 \
    --vllm_num_engines 1 \
    --vllm_tensor_parallel_size 1 \
    --colocate_all_models \
    --vllm_gpu_memory_utilization 0.20 \
    --pretrain "$MODEL" \
    --critic_pretrain "$MODEL" \
    --agent_func_path "$PBS_O_WORKDIR/examples/openrlhf/nash_rs_agent.py" \
    --save_path "$SAVE_PATH" \
    --ckpt_path "$CKPT_PATH" \
    --save_hf_ckpt \
    --disable_ds_ckpt \
    --micro_train_batch_size "$MICRO_TRAIN_BATCH_SIZE" \
    --train_batch_size "$TRAIN_BATCH_SIZE" \
    --micro_rollout_batch_size "$MICRO_ROLLOUT_BATCH_SIZE" \
    --rollout_batch_size "$ROLLOUT_BATCH_SIZE" \
    --vllm_generate_batch_size "$VLLM_GENERATE_BATCH_SIZE" \
    --n_samples_per_prompt 1 \
    --seed "$TRAIN_SEED" \
    --num_episodes "$NUM_EPISODES" \
    --max_epochs 1 \
    --max_samples "$MAX_SAMPLES" \
    --prompt_max_len "$PROMPT_MAX_LEN" \
    --generate_max_len "$GENERATE_MAX_LEN" \
    --zero_stage 2 \
    --param_dtype bf16 \
    --actor_learning_rate "$ACTOR_LR" \
    --critic_learning_rate "$CRITIC_LR" \
    --lr_warmup_ratio "$LR_WARMUP_RATIO" \
    --lr_scheduler "$LR_SCHEDULER" \
    --init_kl_coef 0.01 \
    --prompt_data "$PROMPT_DATA" \
    --input_key prompt \
    --apply_chat_template \
    --attn_implementation sdpa \
    --enforce_eager \
    --logging_steps 1 \
    --save_steps "$SAVE_STEPS" \
    --max_ckpt_num "$MAX_CKPT_NUM"

singularity exec -e "$IMAGE" env \
  PYTHONPATH="$PBS_O_WORKDIR/src" \
  "$VENV/bin/python" examples/export_openrlhf_metrics.py \
    --log "$PBS_O_WORKDIR/stdout.${PBS_JOBID}" \
    --output "$METRICS_OUTPUT" \
    --samples-per-step "$ROLLOUT_BATCH_SIZE"

if [[ "$VERIFY_PARAMETER_UPDATE" == "1" ]]; then
  singularity exec -e "$IMAGE" env \
    HF_HOME="$SCRATCH_ROOT/cache/huggingface" \
    HUGGINGFACE_HUB_CACHE="$HF_CACHE" \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONPATH="$PBS_O_WORKDIR/src" \
    "$VENV/bin/python" examples/verify_checkpoint_update.py \
      --base-model "$MODEL" \
      --checkpoint "$SAVE_PATH" \
      --output "$VERIFY_OUTPUT"
fi

if [[ "$RUN_FIXED_EVAL" == "1" ]]; then
  singularity exec --nv "$IMAGE" env \
    CUDA_VISIBLE_DEVICES="$VLLM_GPU_INDEX" \
    TRITON_LIBCUDA_PATH="$CUDA_DRIVER_LIB" \
    HF_HOME="$SCRATCH_ROOT/cache/huggingface" \
    HUGGINGFACE_HUB_CACHE="$HF_CACHE" \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONPATH="$PBS_O_WORKDIR/src" \
    "$VENV/bin/python" examples/evaluate_ppo_checkpoints.py \
      --prompts "$EVAL_PROMPT_DATA" \
      --base-model "$MODEL" \
      --checkpoint-root "$CKPT_PATH" \
      --final-model "$SAVE_PATH" \
      --preference-model "$PM_MODEL" \
      --preference-revision "$PM_REVISION" \
      --run-seed "$TRAIN_SEED" \
      --max-new-tokens "$GENERATE_MAX_LEN" \
      --output-dir "$RUN_ROOT/fixed_eval"
fi

if [[ "$RUN_INDEPENDENT_EVAL" == "1" ]]; then
  singularity exec --nv "$IMAGE" env \
    CUDA_VISIBLE_DEVICES="$VLLM_GPU_INDEX" \
    TRITON_LIBCUDA_PATH="$CUDA_DRIVER_LIB" \
    HF_HOME="$SCRATCH_ROOT/cache/huggingface" \
    HUGGINGFACE_HUB_CACHE="$HF_CACHE" \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONPATH="$PBS_O_WORKDIR/src" \
    "$VENV/bin/python" examples/evaluate_ppo_checkpoints.py \
      --prompts "$TEST_PROMPT_DATA" \
      --base-model "$MODEL" \
      --checkpoint-root "$CKPT_PATH" \
      --final-model "$SAVE_PATH" \
      --preference-model "$PM_MODEL" \
      --preference-revision "$PM_REVISION" \
      --run-seed "$TRAIN_SEED" \
      --max-new-tokens 512 \
      --batch-size 8 \
      --steps 24 \
      --bootstrap-samples 2000 \
      --output-dir "$RUN_ROOT/independent_test_128"
fi

echo "Nash-RS OpenRLHF $RUN_LABEL completed successfully."
